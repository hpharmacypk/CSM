# Copy this file to .env.local and fill in the values from your Supabase project:
#   Supabase Dashboard → Project Settings → API Keys / Data API
#
# Both values are PUBLIC (they are shipped to the browser). Access is enforced by
# Row Level Security and database functions, not by keeping these secret.
#
# Never put the database password or admin password in this file, in .env.local,
# or in Git. The chat itself needs no secret key. Only the optional order-agent
# bridge (bottom of this file) needs the Supabase secret key, on the server only.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Order-agent bridge (optional, off by default). SERVER-ONLY secrets: never prefix
# these with NEXT_PUBLIC_, never commit real values. Set them in Hostinger hPanel.
# See README "Update: order-agent bridge".
# -----------------------------------------------------------------------------
AGENT_BRIDGE_ENABLED=false
SUPABASE_SECRET_KEY=
N8N_INBOX_WEBHOOK_URL=
N8N_INBOX_WEBHOOK_HEADER_NAME=
N8N_INBOX_WEBHOOK_HEADER_VALUE=
AGENT_CALLBACK_SECRET=
AGENT_DISPATCH_SECRET=

# -----------------------------------------------------------------------------
# Reply notifications (Web Push, optional, off by default). SERVER-ONLY: never
# NEXT_PUBLIC_, never commit real values. Generate the pair once with
#   npx web-push generate-vapid-keys
# and keep it: a new pair stops every existing subscription.
# Uses SUPABASE_SECRET_KEY above. See README "Update: reply notifications".
# -----------------------------------------------------------------------------
WEB_PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com
